# Generated from 1Password vault "Developer Secrets".
# Materialize values:  op inject -i .env.example -o .env
# Run inline:          op run --env-file=.env.example -- <cmd>
# Source file:         .env.local

SUPABASE_URL=op://Developer Secrets/Supabase letspepper/url
SUPABASE_SERVICE_ROLE_KEY=op://Developer Secrets/Supabase letspepper/service_role_key
NEXT_PUBLIC_CF_STREAM_SUBDOMAIN=mztsxz382jswgq00

# Rally HQ backend (ADR-0007 cross-surface fan identity). The server mints/looks
# up a fan_token per device against rallyhq.app and presents it with engagement
# writes. Only the API key is required (set it in the Cloudflare Pages dashboard
# for the `letspepper` project); the URL defaults to https://rallyhq.app and is
# only worth overriding for local/staging.
RALLY_HQ_API_KEY=op://Developer Secrets/RallyHQ API letspepper/credential
# RALLY_HQ_API_URL=https://rallyhq.app  # optional override
